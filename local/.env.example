# Server Configuration
PORT=8080
DATA_DIR=./data

# Security Configuration
# Enable authentication for the dashboard
OCTOMUS_AUTH=false
# Pre-set a persistent admin token (optional)
# OCTOMUS_TOKEN=your_secure_token

# Encryption Key (Optional, generated if missing)
# MASTER_KEY=...

# Octomus Cloud Integration (Recommended)
# Enables cloud features and LLM tunneling
OCTOMUS_USE_CLOUD_AUTH=true
# Optional: Override cloud URL (default: wss://octomus.dev/tunnel/connect)
# OCTOMUS_CLOUD_URL=wss://octomus.dev/tunnel/connect

# Local Google OAuth Credentials (Optional)
# Only needed if NOT using Octomus Cloud Auth
# Create these at https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your_client_id_here
# GOOGLE_CLIENT_SECRET=your_client_secret_here
